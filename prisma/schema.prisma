// BBB — CPE Department Sinking-fund System
// Exact currency: Decimal @db.Decimal(12, 2) → PostgreSQL NUMERIC(12, 2)
// Policy engine: src/lib/finance/cpe-policy.ts

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  TREASURER
  AUDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContributionStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum InterestType {
  FLAT
  DIMINISHING
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  DEFAULTED
  REJECTED
}

enum AmortizationStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum RepaymentFrequency {
  KINSENAS // 4 installments across 2 months
  MONTHLY // 2 monthly amortizations
}

enum PaymentTargetType {
  CONTRIBUTION
  LOAN_AMORTIZATION
}

enum PaymentChannel {
  GCASH
  MAYA
  BANK_TRANSFER
  /// Other e-wallets / digital rails (GrabPay, ShopeePay, etc.)
  OTHER_DIGITAL
  CASH
}

enum PaymentSubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  AUDITED
  FLAGGED
}

enum LedgerEntryType {
  CONTRIBUTION_IN
  LOAN_DISBURSEMENT_OUT
  PRINCIPAL_REPAYMENT_IN
  INTEREST_INCOME_IN
  PENALTY_INCOME_IN
  REVERSAL_ADJUSTMENT
}

enum PenaltyWaiverScope {
  SINGLE
  BULK
  ALL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id   String @id @default(cuid())
  name String
  /// Fund members (MEMBER/TREASURER/AUDITOR). Null for username-only ADMIN accounts.
  email String? @unique
  /// ADMIN login identifier. Null for email-based fund members.
  username String? @unique
  role     UserRole   @default(MEMBER)
  status   UserStatus @default(ACTIVE)
  /// Enrolled household heads (Rule #4). Minimum contribution = ₱250 × headsCount per kinsenas.
  headsCount Int      @default(1)
  /// scrypt hash of the user's 6-digit unlock PIN (set once; reused across devices).
  pinHash   String?
  /// Residual credit after verified overpayments (FIFO-applied to new obligations).
  prepaidCredit Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  contributions        Contribution[]
  loans                Loan[]              @relation("LoanBorrower")
  approvedLoans        Loan[]              @relation("LoanApprover")
  paymentSubmissions   PaymentSubmission[] @relation("PaymentSubmitter")
  verifiedPayments     PaymentSubmission[] @relation("PaymentVerifier")
  auditedPayments      PaymentSubmission[] @relation("PaymentAuditor")
  ledgerEntries        LedgerEntry[]       @relation("LedgerUser")
  createdLedgerEntries LedgerEntry[]       @relation("LedgerCreator")
  penaltyWaiversIssued PenaltyWaiver[]     @relation("PenaltyWaiverIssuer")
  deviceCredentials    DeviceCredential[]

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Device-bound credential for optional PIN unlock after soft sign-out.
model DeviceCredential {
  id             String    @id @default(cuid())
  userId         String
  /// SHA-256 hex of the opaque device token held in client localStorage.
  tokenHash      String
  label          String?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("device_credentials")
}

model FundCycle {
  id String @id @default(cuid())
  name String
  /// ₱250 / head / kinsenas (Rule #4). Kept as contributionAmount for cycle config.
  contributionAmount Decimal @default(250) @db.Decimal(12, 2)
  /// Flat loan interest for the full term (Rule #2). Default 0.10 = 10%.
  loanInterestRate Decimal @default(0.100000) @db.Decimal(8, 6)
  /// ₱10 / head / day after grace (Rule #3).
  penaltyRate Decimal @default(10.00) @db.Decimal(12, 2)
  /// Calendar days after due date before penalties accrue (Rule #3).
  gracePeriodDays Int @default(2)
  /// Max loanable = (monthlyCollectibles × ratio) × headsCount (Rule #1).
  maxLoanablePoolRatio Decimal @default(0.500000) @db.Decimal(8, 6)
  /// Fixed CPE loan term in months (Rule #2).
  loanTermMonths Int @default(2)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions  Contribution[]
  loans          Loan[]
  ledgerEntries  LedgerEntry[]
  penaltyWaivers PenaltyWaiver[]

  @@index([isActive])
  @@map("fund_cycles")
}

model Contribution {
  id      String @id @default(cuid())
  userId  String
  cycleId String
  /// First calendar day of the contribution month.
  periodMonth DateTime @db.Date
  /// 1 = 15th kinsenas, 2 = 30th (or last day of February).
  kinsenaIndex Int
  /// Heads enrolled when this obligation was created (Rule #4 snapshot).
  headsSnapshot Int @default(1)
  amountDue  Decimal            @db.Decimal(12, 2)
  amountPaid Decimal            @default(0) @db.Decimal(12, 2)
  /// Accrued late fee (Rule #3). Frozen at valid receipt submittedAt.
  penaltyAmount Decimal            @default(0) @db.Decimal(12, 2)
  /// Cumulative late fee waived via PenaltyWaiver (audit display).
  penaltyWaivedAmount Decimal         @default(0) @db.Decimal(12, 2)
  /// When true, cron skips further Rule #3 accrual (pass granted).
  penaltyAccrualFrozen Boolean        @default(false)
  daysDelayed   Int                @default(0)
  status        ContributionStatus @default(UNPAID)
  dueDate       DateTime           @db.Date
  /// dueDate + FundCycle.gracePeriodDays (typically +2 calendar days).
  graceDeadline DateTime           @db.Date
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  cycle              FundCycle           @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  paymentSubmissions PaymentSubmission[]
  penaltyWaivers     PenaltyWaiver[]

  @@unique([userId, cycleId, periodMonth, kinsenaIndex])
  @@index([cycleId, status])
  @@index([userId, status])
  @@index([dueDate])
  @@index([graceDeadline, status])
  @@map("contributions")
}

model Loan {
  id                 String             @id @default(cuid())
  borrowerId         String
  cycleId            String
  principalAmount    Decimal            @db.Decimal(12, 2)
  /// Flat rate for the full term (Rule #2). Default 0.10 = 10%.
  interestRate       Decimal            @db.Decimal(8, 6)
  termMonths         Int                @default(2)
  interestType       InterestType       @default(FLAT)
  repaymentFrequency RepaymentFrequency @default(KINSENAS)
  /// Heads at loan request time (penalty basis for Rule #3).
  headsSnapshot      Int                @default(1)
  status             LoanStatus         @default(PENDING)
  approvedById       String?
  disbursedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  borrower      User               @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  cycle         FundCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  approvedBy    User?              @relation("LoanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  amortizations LoanAmortization[]
  ledgerEntries LedgerEntry[]

  @@index([borrowerId, status])
  @@index([cycleId, status])
  @@index([status])
  @@map("loans")
}

model LoanAmortization {
  id                 String             @id @default(cuid())
  loanId             String
  installmentNumber  Int
  dueDate            DateTime           @db.Date
  graceDeadline      DateTime           @db.Date
  /// Heads snapshot used for Rule #3 late fees on this installment.
  headsSnapshot      Int                @default(1)
  principalComponent Decimal            @db.Decimal(12, 2)
  interestComponent  Decimal            @db.Decimal(12, 2)
  penaltyAmount      Decimal            @default(0) @db.Decimal(12, 2)
  /// Cumulative late fee waived via PenaltyWaiver (audit display).
  penaltyWaivedAmount Decimal           @default(0) @db.Decimal(12, 2)
  /// When true, cron skips further Rule #3 accrual (pass granted).
  penaltyAccrualFrozen Boolean          @default(false)
  daysDelayed        Int                @default(0)
  amountPaid         Decimal            @default(0) @db.Decimal(12, 2)
  status             AmortizationStatus @default(UNPAID)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentSubmissions PaymentSubmission[]
  penaltyWaivers     PenaltyWaiver[]

  @@unique([loanId, installmentNumber])
  @@index([loanId, status])
  @@index([dueDate, status])
  @@index([graceDeadline, status])
  @@map("loan_amortizations")
}

model PaymentSubmission {
  id                 String                  @id @default(cuid())
  userId             String
  targetType         PaymentTargetType
  contributionId     String?
  loanAmortizationId String?
  amount             Decimal                 @db.Decimal(12, 2)
  paymentChannel     PaymentChannel
  referenceNumber    String
  /// Storage path for receipt image. Optional for CASH (date attestation instead).
  receiptUrl         String?
  /// Member-declared calendar date the payment was made (required; primary proof for cash).
  paidAt             DateTime                @db.Date
  /// Original AI OCR amount (for treasurer tamper detection)
  aiExtractedAmount  Decimal?                @db.Decimal(12, 2)
  /// Original AI OCR reference number
  aiExtractedRefNo   String?
  /// Original AI OCR payment channel
  aiExtractedChannel PaymentChannel?
  /// AI confidence / quality warning (blurry, cropped, etc.)
  aiConfidenceNote   String?
  status             PaymentSubmissionStatus @default(PENDING_VERIFICATION)
  verifiedById       String?
  verifiedAt         DateTime?
  auditedById        String?
  auditedAt          DateTime?
  remarks            String?
  /// Period-scoped waterfall lines (planned on submit; replaced on verify).
  allocationSummary  String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user             User              @relation("PaymentSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  contribution     Contribution?     @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  loanAmortization LoanAmortization? @relation(fields: [loanAmortizationId], references: [id], onDelete: SetNull)
  verifiedBy       User?             @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  auditedBy        User?             @relation("PaymentAuditor", fields: [auditedById], references: [id], onDelete: SetNull)
  ledgerEntries    LedgerEntry[]

  // Anti-fraud: one reference number per payment channel
  @@unique([paymentChannel, referenceNumber])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([contributionId])
  @@index([loanAmortizationId])
  @@map("payment_submissions")
}

/// Immutable late-fee pass (payroll / exception waivers). Append-only.
model PenaltyWaiver {
  id                   String              @id @default(cuid())
  cycleId              String
  targetType           PaymentTargetType
  contributionId       String?
  loanAmortizationId   String?
  amountWaived         Decimal             @db.Decimal(12, 2)
  reason               String
  scope                PenaltyWaiverScope
  /// Shared across rows created in one bulk/all action.
  batchId              String
  issuedById           String
  createdAt            DateTime            @default(now())

  cycle            FundCycle         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  contribution     Contribution?     @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  loanAmortization LoanAmortization? @relation(fields: [loanAmortizationId], references: [id], onDelete: SetNull)
  issuedBy         User              @relation("PenaltyWaiverIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([cycleId, createdAt])
  @@index([batchId])
  @@index([contributionId])
  @@index([loanAmortizationId])
  @@index([issuedById])
  @@map("penalty_waivers")
}

/// Append-only double-entry ledger. Balances are derived — never overwrite rows.
model LedgerEntry {
  id                  String          @id @default(cuid())
  cycleId             String
  userId              String
  paymentSubmissionId String?
  loanId              String?
  entryType           LedgerEntryType
  amount              Decimal         @db.Decimal(12, 2)
  description         String
  createdById         String
  createdAt           DateTime        @default(now())

  cycle             FundCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  user              User               @relation("LedgerUser", fields: [userId], references: [id], onDelete: Restrict)
  paymentSubmission PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: SetNull)
  loan              Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([cycleId, createdAt])
  @@index([userId, entryType])
  @@index([loanId])
  @@index([paymentSubmissionId])
  @@map("ledger_entries")
}
